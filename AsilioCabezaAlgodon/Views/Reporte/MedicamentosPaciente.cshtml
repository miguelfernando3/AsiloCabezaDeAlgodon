
@model List<AsilioCabezaAlgodon.Entidades.Medicamento>
@using AsilioCabezaAlgodon.Entidades
@using System.Linq

@{
    ViewData["Title"] = "Medicamentos por Paciente";

    var paciente = ViewBag.Paciente as Paciente;

    decimal totalMedicamentos = Model
        .Where(m => m.Estado == "Despachado")
        .Sum(m => Math.Max(0m, m.Costo - m.Descuento));
}

<div class="container mt-4">

    <h2>Reporte de Medicamentos por Paciente</h2>

    <h4>
        Paciente: @paciente?.Nombre @paciente?.Apellido
    </h4>

    <p>
        Medicamentos registrados para el paciente.
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Medicamento</th>
                <th>Dosis</th>
                <th>Duración</th>
                <th>Estado</th>
                <th>Costo original (Q)</th>
                <th>Descuento (Q)</th>
                <th>Total (Q)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var medicamento in Model)
            {
                decimal totalMedicamento = Math.Max(
                    0m, medicamento.Costo - medicamento.Descuento);

                <tr>
                    <td>@medicamento.Nombre</td>
                    <td>@medicamento.Dosis</td>
                    <td>@medicamento.Duracion</td>

                    <td>
                        @if (medicamento.Estado == "Despachado")
                        {
                            <span class="badge bg-success">
                                Despachado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Pendiente
                            </span>
                        }
                    </td>

                    <td>
                        Q @medicamento.Costo.ToString("N2")
                    </td>

                    <td>
                        Q @medicamento.Descuento.ToString("N2")
                    </td>

                    <td>
                        <strong>
                            Q @totalMedicamento.ToString("N2")
                        </strong>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Este paciente no tiene medicamentos registrados.
        </div>
    }

    <hr />

    <h3>
        Total de medicamentos despachados:
        Q @totalMedicamentos.ToString("N2")
    </h3>

    <p class="text-muted">
        El total incluye únicamente medicamentos
        con estado Despachado y aplica los descuentos
        de la fundación. No representa necesariamente
        dinero pagado.
    </p>

    <a asp-controller="Reporte"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Volver a reportes
    </a>

</div>
