
@model List<AsilioCabezaAlgodon.Entidades.Medicamento>
@using AsilioCabezaAlgodon.Entidades

@{
    ViewData["Title"] = "Medicamentos por Paciente";

    var paciente = ViewBag.Paciente as Paciente;

    decimal totalMedicamentos = ViewBag.TotalMedicamentos;
}

<div class="container mt-4">

    <h2>Reporte de Medicamentos por Paciente</h2>

    <h4>
        Paciente: @paciente?.Nombre @paciente?.Apellido
    </h4>

    <p>
        Medicamentos registrados para el paciente.
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Medicamento</th>
                <th>Dosis</th>
                <th>Duración</th>
                <th>Estado</th>
                <th>Costo (Q)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var medicamento in Model)
            {
                <tr>
                    <td>@medicamento.Nombre</td>
                    <td>@medicamento.Dosis</td>
                    <td>@medicamento.Duracion</td>
                    <td>@medicamento.Estado</td>
                    <td>Q @medicamento.Costo.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Este paciente no tiene medicamentos registrados.
        </div>
    }

    <hr />

    <h3>
        Total de medicamentos despachados:
        Q @totalMedicamentos.ToString("N2")
    </h3>

    <p class="text-muted">
        El total incluye únicamente medicamentos
        con estado Despachado.
        No representa necesariamente dinero pagado.
    </p>

    <a asp-controller="Reporte"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Volver a reportes
    </a>

</div>
