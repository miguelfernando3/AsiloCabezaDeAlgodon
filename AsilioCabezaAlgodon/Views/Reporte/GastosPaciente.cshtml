
@using AsilioCabezaAlgodon.Entidades

@{
    ViewData["Title"] = "Gastos Médicos por Paciente";

    var paciente = ViewBag.Paciente as Paciente;

    var citas = ViewBag.Citas as List<CitaMedica>
        ?? new List<CitaMedica>();

    var examenes = ViewBag.Examenes as List<ExamenLaboratorio>
        ?? new List<ExamenLaboratorio>();

    var medicamentos = ViewBag.Medicamentos as List<Medicamento>
        ?? new List<Medicamento>();

    decimal totalConsultas = ViewBag.TotalConsultas;
    decimal totalLaboratorio = ViewBag.TotalLaboratorio;
    decimal totalMedicamentos = ViewBag.TotalMedicamentos;
    decimal totalGeneral = ViewBag.TotalGeneral;
}

<div class="container mt-4">

    <h2>Reporte de Gastos Médicos</h2>

    <h4>
        Paciente: @paciente?.Nombre @paciente?.Apellido
    </h4>

    <hr />

    <h5>Consultas médicas</h5>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Motivo</th>
                <th>Costo original (Q)</th>
                <th>Descuento (Q)</th>
                <th>Total (Q)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var cita in citas)
            {
                decimal total = Math.Max(
                    0m, cita.CostoConsulta - cita.Descuento);

                <tr>
                    <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@cita.Motivo</td>
                    <td>Q @cita.CostoConsulta.ToString("N2")</td>
                    <td>Q @cita.Descuento.ToString("N2")</td>
                    <td>
                        <strong>Q @total.ToString("N2")</strong>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (citas.Count == 0)
    {
        <p class="text-muted">
            No hay consultas médicas registradas.
        </p>
    }

    <p>
        <strong>Total consultas:</strong>
        Q @totalConsultas.ToString("N2")
    </p>

    <hr />

    <h5>Exámenes de laboratorio</h5>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Examen</th>
                <th>Costo original (Q)</th>
                <th>Descuento (Q)</th>
                <th>Total (Q)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var examen in examenes)
            {
                decimal total = Math.Max(
                    0m, examen.Costo - examen.Descuento);

                <tr>
                    <td>@examen.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@examen.NombreExamen</td>
                    <td>Q @examen.Costo.ToString("N2")</td>
                    <td>Q @examen.Descuento.ToString("N2")</td>
                    <td>
                        <strong>Q @total.ToString("N2")</strong>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (examenes.Count == 0)
    {
        <p class="text-muted">
            No hay exámenes de laboratorio registrados.
        </p>
    }

    <p>
        <strong>Total laboratorio:</strong>
        Q @totalLaboratorio.ToString("N2")
    </p>

    <hr />

    <h5>Medicamentos despachados</h5>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Medicamento</th>
                <th>Costo original (Q)</th>
                <th>Descuento (Q)</th>
                <th>Total (Q)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var medicamento in medicamentos)
            {
                decimal total = Math.Max(
                    0m, medicamento.Costo - medicamento.Descuento);

                <tr>
                    <td>@medicamento.Nombre</td>
                    <td>Q @medicamento.Costo.ToString("N2")</td>
                    <td>Q @medicamento.Descuento.ToString("N2")</td>
                    <td>
                        <strong>Q @total.ToString("N2")</strong>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (medicamentos.Count == 0)
    {
        <p class="text-muted">
            No hay medicamentos despachados.
        </p>
    }

    <p>
        <strong>Total medicamentos:</strong>
        Q @totalMedicamentos.ToString("N2")
    </p>

    <hr />

    <h4>
        Total general de gastos:
        Q @totalGeneral.ToString("N2")
    </h4>

    <p class="text-muted">
        Este reporte muestra los costos médicos registrados,
        aplicando los descuentos de la fundación.
        En medicamentos se incluyen únicamente los despachados.
        Los valores no representan necesariamente el dinero pagado.
    </p>

    <a asp-controller="Reporte"
       asp-action="Index"
       class="btn btn-secondary">
        Volver a reportes
    </a>

</div>
