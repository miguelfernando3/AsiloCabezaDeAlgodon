
@model List<AsilioCabezaAlgodon.Entidades.ExamenLaboratorio>
@using AsilioCabezaAlgodon.Entidades
@using System.Linq

@{
    ViewData["Title"] = "Laboratorios por Paciente";

    var paciente = ViewBag.Paciente as Paciente;

    decimal totalLaboratorio = Model.Sum(e =>
        Math.Max(0m, e.Costo - e.Descuento));
}

<div class="container mt-4">

    <h2>Reporte de Laboratorios por Paciente</h2>

    <h4>
        Paciente: @paciente?.Nombre @paciente?.Apellido
    </h4>

    <p>
        Exámenes de laboratorio registrados para el paciente.
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Nombre del examen</th>
                <th>Costo original (Q)</th>
                <th>Descuento (Q)</th>
                <th>Total a pagar (Q)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var examen in Model)
            {
                decimal totalExamen = Math.Max(
                    0m, examen.Costo - examen.Descuento);

                <tr>
                    <td>@examen.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@examen.NombreExamen</td>
                    <td>Q @examen.Costo.ToString("N2")</td>
                    <td>Q @examen.Descuento.ToString("N2")</td>
                    <td>
                        <strong>
                            Q @totalExamen.ToString("N2")
                        </strong>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Este paciente no tiene exámenes de laboratorio registrados.
        </div>
    }

    <hr />

    <h3>
        Total de laboratorio:
        Q @totalLaboratorio.ToString("N2")
    </h3>

    <p class="text-muted">
        El total incluye los descuentos de la fundación.
        Representa los costos de los exámenes,
        no necesariamente los pagos recibidos.
    </p>

    <a asp-controller="Reporte"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Volver a reportes
    </a>

</div>
