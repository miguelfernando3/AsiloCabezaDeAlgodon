
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Reportes del Asilo";

    var listaPacientes =
        ViewBag.ListaPacientes as SelectList;
}

<h1>Reportes del Asilo</h1>

<p class="lead">
    Resumen general de la información registrada en el sistema.
</p>

<div class="row">

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Pacientes registrados</h5>
                <h2>@ViewBag.TotalPacientes</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Citas médicas</h5>
                <h2>@ViewBag.TotalCitas</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Visitas médicas</h5>
                <h2>@ViewBag.TotalVisitas</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Familiares registrados</h5>
                <h2>@ViewBag.TotalFamiliares</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Total de pagos</h5>
                <h2>Q @ViewBag.TotalPagos.ToString("N2")</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Total de donaciones</h5>
                <h2>Q @ViewBag.TotalDonaciones.ToString("N2")</h2>
            </div>
        </div>
    </div>

</div>

<hr />

<h3>Gastos médicos por paciente</h3>

<p>
    Seleccione un paciente para consultar los costos
    de sus consultas médicas, exámenes de laboratorio
    y medicamentos.
</p>

<form asp-controller="Reporte"
      asp-action="GastosPaciente"
      method="get">

    <div class="mb-3">
        <label for="pacienteId" class="form-label">
            Seleccionar paciente
        </label>

        <select id="pacienteId"
                name="pacienteId"
                asp-items="listaPacientes"
                class="form-select"
                required>
            <option value="">
                Seleccione un paciente
            </option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Ver gastos médicos
    </button>

</form>

<hr />


<h3>Reporte de cobros por fechas</h3>

<p>
    Consulte los pagos recibidos por el asilo
    durante un período determinado.
</p>

<a asp-controller="Reporte"
   asp-action="Cobros"
   class="btn btn-primary mb-3">
    Ver reporte de cobros
</a>

<hr />

<a asp-controller="Home"
   asp-action="Index"
   class="btn btn-secondary">
    Volver al inicio
</a>
