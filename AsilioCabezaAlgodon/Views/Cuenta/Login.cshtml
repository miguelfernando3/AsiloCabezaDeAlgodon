
@model AsilioCabezaAlgodon.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">

        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h3>Asilo Cabeza de Algodón</h3>
                <p class="mb-0">Inicio de sesión</p>
            </div>

            <div class="card-body">

                <form asp-controller="Cuenta"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">
                            Correo electrónico
                        </label>

                        <input asp-for="Correo"
                               class="form-control"
                               autocomplete="username"
                               placeholder="usuario@gmail.com" />

                        <span asp-validation-for="Correo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label">
                            Contraseña
                        </label>

                        <input asp-for="Contrasena"
                               class="form-control"
                               autocomplete="current-password" />

                        <span asp-validation-for="Contrasena"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Recordarme"
                               class="form-check-input" />

                        <label asp-for="Recordarme"
                               class="form-check-label">
                            Recordarme
                        </label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RolSeleccionado"
                               class="form-label">
                            Seleccione su cargo
                        </label>

                        <select asp-for="RolSeleccionado"
                                class="form-select">

                            <option value="">
                                -- Seleccione su cargo --
                            </option>

                            <option value="Administrador">
                                Administrador
                            </option>

                            <option value="Recepcionista">
                                Recepcionista
                            </option>

                            <option value="Medico">
                                Médico
                            </option>

                            <option value="Enfermero">
                                Enfermero
                            </option>

                            <option value="Laboratorio">
                                Laboratorio
                            </option>

                            <option value="Farmacia">
                                Farmacia
                            </option>

                            <option value="Fundacion">
                                Fundación
                            </option>

                        </select>

                        <span asp-validation-for="RolSeleccionado"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Iniciar sesión
                    </button>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
