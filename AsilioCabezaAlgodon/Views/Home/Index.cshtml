@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">Asilo de Ancianos Cabeza de Algodón</h1>
    <p class="lead">
        Sistema de Administración del Asilo
    </p>
</div>

<div class="row mt-4">

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Registro de Ancianos</h5>
                <p class="card-text">
                    Administrar la información de los pacientes.
                </p>
                <a href="/Paciente/Index" class="btn btn-primary">Ingresar</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Módulo Médico</h5>
                <p class="card-text">
                    Consultas, visitas médicas y diagnósticos.
                </p>
                <a href="#" class="btn btn-primary">Ingresar</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Pagos y Donaciones</h5>
                <p class="card-text">
                    Administrar pagos y donaciones.
                </p>
                <a href="#" class="btn btn-primary">Ingresar</a>
            </div>
        </div>
    </div>

</div>