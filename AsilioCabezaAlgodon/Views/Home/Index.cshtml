
@{
    ViewData["Title"] = "Inicio";

    bool administrador = User.IsInRole("Administrador");
    bool recepcionista = User.IsInRole("Recepcionista");
    bool medico = User.IsInRole("Medico");
    bool enfermero = User.IsInRole("Enfermero");
    bool laboratorio = User.IsInRole("Laboratorio");
    bool farmacia = User.IsInRole("Farmacia");
    bool fundacion = User.IsInRole("Fundacion");

    bool verPacientes = administrador || recepcionista ||
                        medico || enfermero;

    bool verVisitas = administrador || medico || enfermero;

    bool verCitas = administrador || recepcionista ||
                    medico || fundacion;

    bool verPagos = administrador || recepcionista ||
                    fundacion;

    bool verDonaciones = administrador || fundacion;

    bool verMedicamentos = administrador || medico ||
                           farmacia || fundacion;

    bool verLaboratorio = administrador || medico ||
                          laboratorio;

    bool verFamiliares = administrador || recepcionista ||
                         medico || enfermero;

    bool verSolicitudes = administrador || medico ||
                          fundacion;

    bool verReportes = administrador;
}

<div class="text-center">
    <h1 class="display-4">
        Asilo de Ancianos Cabeza de Algodón
    </h1>

    <p class="lead">
        Sistema de Administración del Asilo
    </p>
</div>

<div class="row mt-4">

    <!-- REGISTRO DE ANCIANOS -->
    @if (verPacientes)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Registro de Ancianos
                    </h5>

                    <p class="card-text">
                        @if (administrador || recepcionista)
                        {
                            <span>
                                Registrar y consultar la información
                                de los pacientes.
                            </span>
                        }
                        else
                        {
                            <span>
                                Consultar la información de los pacientes.
                            </span>
                        }
                    </p>

                    <a asp-controller="Paciente"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ingresar
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- MODULO MEDICO -->
    @if (verVisitas || verCitas)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Módulo Médico
                    </h5>

                    <p class="card-text">
                        Consultar citas y visitas médicas
                        según los permisos del usuario.
                    </p>

                    @if (verVisitas)
                    {
                        <a asp-controller="VisitaMedica"
                           asp-action="Index"
                           class="btn btn-primary mb-2">
                            Ver visitas médicas
                        </a>
                    }

                    @if (verCitas)
                    {
                        <a asp-controller="CitaMedica"
                           asp-action="Index"
                           class="btn btn-success mb-2">
                            Ver citas médicas
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <!-- PAGOS Y DONACIONES -->
    @if (verPagos || verDonaciones)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Pagos y Donaciones
                    </h5>

                    <p class="card-text">
                        Consultar pagos y donaciones
                        según los permisos del usuario.
                    </p>

                    @if (verPagos)
                    {
                        <a asp-controller="Pago"
                           asp-action="Index"
                           class="btn btn-primary mb-2">
                            Ver pagos
                        </a>
                    }

                    @if (verDonaciones)
                    {
                        <a asp-controller="Donacion"
                           asp-action="Index"
                           class="btn btn-success mb-2">
                            Ver donaciones
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <!-- MEDICAMENTOS Y FARMACIA -->
    @if (verMedicamentos)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Medicamentos y Farmacia
                    </h5>

                    <p class="card-text">
                        Consultar medicamentos, tratamientos y costos.
                    </p>

                    <a asp-controller="Medicamento"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ver medicamentos
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- LABORATORIO -->
    @if (verLaboratorio)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Laboratorio
                    </h5>

                    <p class="card-text">
                        Consultar exámenes y resultados de laboratorio.
                    </p>

                    <a asp-controller="ExamenLaboratorio"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ver exámenes
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- ADMINISTRACION DE USUARIOS -->
    @if (administrador)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Administración de Usuarios
                    </h5>

                    <p class="card-text">
                        Registrar empleados y administrar sus roles.
                    </p>

                    <a asp-controller="Usuario"
                       asp-action="Index"
                       class="btn btn-primary">
                        Administrar usuarios
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- FAMILIARES -->
    @if (verFamiliares)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Familiares de Pacientes
                    </h5>

                    <p class="card-text">
                        @if (administrador || recepcionista)
                        {
                            <span>
                                Registrar y consultar los familiares
                                de los pacientes del asilo.
                            </span>
                        }
                        else
                        {
                            <span>
                                Consultar los familiares
                                de los pacientes del asilo.
                            </span>
                        }
                    </p>

                    <a asp-controller="Familiar"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ver familiares
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- SOLICITUDES MEDICAS -->
    @if (verSolicitudes)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Solicitudes Médicas
                    </h5>

                    <p class="card-text">
                        @if (fundacion && !administrador)
                        {
                            <span>
                                Consultar solicitudes médicas
                                y programar citas con especialistas.
                            </span>
                        }
                        else
                        {
                            <span>
                                Consultar y registrar solicitudes médicas.
                            </span>
                        }
                    </p>

                    <a asp-controller="SolicitudMedica"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ver solicitudes
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- REPORTES DEL ASILO -->
    @if (verReportes)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Reportes del Asilo
                    </h5>

                    <p class="card-text">
                        Consultar el resumen de pacientes,
                        citas, visitas, pagos y donaciones.
                    </p>

                    <a asp-controller="Reporte"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ver reportes
                    </a>
                </div>
            </div>
        </div>
    }

</div>
