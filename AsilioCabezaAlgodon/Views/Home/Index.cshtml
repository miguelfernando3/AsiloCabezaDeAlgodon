
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">Asilo de Ancianos Cabeza de Algodón</h1>
    <p class="lead">
        Sistema de Administración del Asilo
    </p>
</div>

<div class="row mt-4">

    <!-- REGISTRO DE ANCIANOS -->
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Registro de Ancianos</h5>
                <p class="card-text">
                    Administrar la información de los pacientes.
                </p>

                <a asp-controller="Paciente"
                   asp-action="Index"
                   class="btn btn-primary">
                    Ingresar
                </a>
            </div>
        </div>
    </div>

    <!-- MODULO MEDICO -->
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Módulo Médico</h5>
                <p class="card-text">
                    Consultas, visitas médicas y diagnósticos.
                </p>

                <a asp-controller="VisitaMedica"
                   asp-action="Index"
                   class="btn btn-primary">
                    Ver visitas médicas
                </a>

                <a asp-controller="CitaMedica"
                   asp-action="Index"
                   class="btn btn-success">
                    Ver citas médicas
                </a>
            </div>
        </div>
    </div>

    <!-- PAGOS Y DONACIONES -->
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Pagos y Donaciones</h5>
                <p class="card-text">
                    Administrar pagos y donaciones.
                </p>

                <a asp-controller="Pago"
                   asp-action="Index"
                   class="btn btn-primary">
                    Ver pagos
                </a>

                <a asp-controller="Donacion"
                   asp-action="Index"
                   class="btn btn-success">
                    Ver donaciones
                </a>
            </div>
        </div>
    </div>

</div>
