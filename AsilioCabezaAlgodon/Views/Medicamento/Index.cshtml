
@model List<AsilioCabezaAlgodon.Entidades.Medicamento>

@{
    ViewData["Title"] = "Medicamentos";
}

<div class="container mt-4">

    <h2>Medicamentos Registrados</h2>

    <p>Listado de medicamentos y sus costos.</p>

    <a asp-controller="Medicamento"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Registrar Medicamento
    </a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Dosis</th>
                <th>Duración</th>
                <th>Costo (Q)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var medicamento in Model)
            {
                <tr>
                    <td>@medicamento.Nombre</td>
                    <td>@medicamento.Dosis</td>
                    <td>@medicamento.Duracion</td>
                    <td>Q @medicamento.Costo.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no hay medicamentos registrados.
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Volver al inicio
    </a>

</div>
