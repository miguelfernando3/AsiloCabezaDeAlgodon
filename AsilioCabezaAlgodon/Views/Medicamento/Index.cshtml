
@model List<AsilioCabezaAlgodon.Entidades.Medicamento>

@using AsilioCabezaAlgodon.Entidades

@{
    ViewData["Title"] = "Medicamentos";

    var visitas = ViewBag.Visitas as List<VisitaMedica>
                  ?? new List<VisitaMedica>();

    var citas = ViewBag.Citas as List<CitaMedica>
                ?? new List<CitaMedica>();

    var pacientes = ViewBag.Pacientes as List<Paciente>
                    ?? new List<Paciente>();
}

<div class="container mt-4">

    <h2>Medicamentos</h2>

    <p>
        Consulte las recetas médicas y los medicamentos
        despachados por farmacia.
    </p>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Aviso"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Aviso"]
        </div>
    }

    @if (User.IsInRole("Administrador") ||
         User.IsInRole("Medico"))
    {
        <a asp-controller="Medicamento"
           asp-action="Create"
           class="btn btn-primary mb-3">
            Recetar medicamento
        </a>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Paciente</th>
                    <th>Medicamento</th>
                    <th>Dosis</th>
                    <th>Duración</th>
                    <th>Estado</th>
                    <th>Costo original (Q)</th>
                    <th>Descuento (Q)</th>
                    <th>Total a pagar (Q)</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var medicamento in Model)
                {
                    string nombrePaciente = "Sin paciente asignado";

                    if (medicamento.VisitaMedicaId.HasValue)
                    {
                        var visita = visitas.FirstOrDefault(v =>
                            v.Id == medicamento.VisitaMedicaId.Value);

                        if (visita != null)
                        {
                            var cita = citas.FirstOrDefault(c =>
                                c.Id == visita.CitaMedicaId);

                            if (cita != null)
                            {
                                var paciente = pacientes.FirstOrDefault(p =>
                                    p.Id == cita.PacienteId);

                                if (paciente != null)
                                {
                                    nombrePaciente =
                                        paciente.Nombre + " " +
                                        paciente.Apellido;
                                }
                            }
                        }
                    }

                    bool pendiente =
                        medicamento.Estado == "Pendiente";

                    decimal totalPagar =
                        medicamento.Costo - medicamento.Descuento;

                    if (totalPagar < 0)
                    {
                        totalPagar = 0;
                    }

                    <tr>
                        <td>@nombrePaciente</td>

                        <td>@medicamento.Nombre</td>

                        <td>@medicamento.Dosis</td>

                        <td>@medicamento.Duracion</td>

                        <td>
                            @if (pendiente)
                            {
                                <span class="badge bg-warning text-dark">
                                    Pendiente
                                </span>
                            }
                            else if (medicamento.Estado == "Despachado")
                            {
                                <span class="badge bg-success">
                                    Despachado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @medicamento.Estado
                                </span>
                            }
                        </td>

                        <td>
                            Q @medicamento.Costo.ToString("N2")
                        </td>

                        <td>
                            Q @medicamento.Descuento.ToString("N2")
                        </td>

                        <td>
                            <strong>
                                Q @totalPagar.ToString("N2")
                            </strong>
                        </td>

                        <td>
                            @if (pendiente &&
                                 medicamento.VisitaMedicaId.HasValue &&
                                 (User.IsInRole("Administrador") ||
                                  User.IsInRole("Farmacia")))
                            {
                                <form asp-controller="Medicamento"
                                      asp-action="Despachar"
                                      asp-route-id="@medicamento.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        Despachar
                                    </button>
                                </form>
                            }
                            else if (medicamento.Estado == "Despachado")
                            {
                                <span class="text-success">
                                    Completado
                                </span>
                            }
                            else if (!medicamento.VisitaMedicaId.HasValue)
                            {
                                <span class="text-muted">
                                    Sin visita médica
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Pendiente
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no hay medicamentos registrados.
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Volver al inicio
    </a>

</div>
