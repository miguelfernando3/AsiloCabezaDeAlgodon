
@model AsilioCabezaAlgodon.Entidades.Medicamento

@{
    ViewData["Title"] = "Recetar Medicamento";
}

<div class="container mt-4">

    <h2>Recetar Medicamento</h2>

    <p>
        Registre el medicamento indicado al paciente.
        Farmacia confirmará su despacho posteriormente.
    </p>

    <form asp-controller="Medicamento"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="VisitaMedicaId" class="form-label">
                Visita médica del paciente
            </label>

            <select asp-for="VisitaMedicaId"
                    asp-items="ViewBag.ListaVisitas"
                    class="form-select"
                    required>
                <option value="">
                    Seleccione una visita médica
                </option>
            </select>

            <span asp-validation-for="VisitaMedicaId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">
                Nombre del medicamento
            </label>

            <input asp-for="Nombre"
                   class="form-control"
                   maxlength="200"
                   required />

            <span asp-validation-for="Nombre"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Dosis" class="form-label">
                Dosis
            </label>

            <input asp-for="Dosis"
                   class="form-control"
                   maxlength="200"
                   placeholder="Ejemplo: 500 mg cada 8 horas"
                   required />

            <span asp-validation-for="Dosis"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Duracion" class="form-label">
                Duración del tratamiento
            </label>

            <input asp-for="Duracion"
                   class="form-control"
                   maxlength="200"
                   placeholder="Ejemplo: 7 días"
                   required />

            <span asp-validation-for="Duracion"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Costo" class="form-label">
                Costo original (Q)
            </label>

            <input asp-for="Costo"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   required />

            <span asp-validation-for="Costo"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descuento" class="form-label">
                Descuento de la fundación (Q)
            </label>

            <input asp-for="Descuento"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   required />

            <span asp-validation-for="Descuento"
                  class="text-danger"></span>

            <small class="text-muted">
                Si no hay descuento, ingrese 0.
            </small>
        </div>

        <div class="alert alert-info">
            El medicamento quedará pendiente hasta que
            Farmacia confirme su despacho.
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar receta
        </button>

        <a asp-controller="Medicamento"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
