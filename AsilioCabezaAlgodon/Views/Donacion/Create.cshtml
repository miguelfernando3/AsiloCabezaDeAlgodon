
@model AsilioCabezaAlgodon.Entidades.Donacion

@{
    ViewData["Title"] = "Registrar donación";
}

<div class="container mt-4">

    <h2>Registrar Donación</h2>

    <p>Ingrese los datos de la donación recibida.</p>

    <form asp-controller="Donacion"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Donante" class="form-label">
                Nombre del donante
            </label>

            <input asp-for="Donante"
                   class="form-control" />

            <span asp-validation-for="Donante"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Monto" class="form-label">
                Monto de la donación (Q)
            </label>

            <input asp-for="Monto"
                   type="number"
                   step="0.01"
                   min="0.01"
                   class="form-control" />

            <span asp-validation-for="Monto"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Fecha" class="form-label">
                Fecha de la donación
            </label>

            <input asp-for="Fecha"
                   type="date"
                   class="form-control"
                   asp-format="{0:yyyy-MM-dd}" />

            <span asp-validation-for="Fecha"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">
                Descripción
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="3"></textarea>

            <span asp-validation-for="Descripcion"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar donación
        </button>

        <a asp-controller="Donacion"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
