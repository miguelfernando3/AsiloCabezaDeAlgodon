
@model List<AsilioCabezaAlgodon.Entidades.Medico>

@{
    ViewData["Title"] = "Médicos Registrados";
}

<div class="container mt-4">

    <h2>Médicos Registrados</h2>

    <p>Listado de médicos y sus especialidades.</p>

    <a asp-controller="Medico"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Registrar Médico
    </a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Especialidad</th>
                <th>Teléfono</th>
                <th>Correo</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var medico in Model)
            {
                <tr>
                    <td>@medico.Nombre</td>
                    <td>@medico.Apellido</td>
                    <td>@medico.Especialidad</td>
                    <td>@medico.Telefono</td>
                    <td>@medico.Correo</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no hay médicos registrados.
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Volver al inicio
    </a>

</div>
