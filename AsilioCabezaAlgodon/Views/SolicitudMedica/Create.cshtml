
@model AsilioCabezaAlgodon.Entidades.SolicitudMedica

@{
    ViewData["Title"] = "Nueva solicitud médica";
}

<h2>Nueva solicitud médica</h2>

<p>
    Complete los datos para solicitar atención
    médica especializada para un paciente.
</p>

<hr />

<div class="row">
    <div class="col-md-7">

        <form asp-controller="SolicitudMedica"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="PacienteId"
                       class="form-label">
                    Paciente
                </label>

                <select asp-for="PacienteId"
                        asp-items="ViewBag.ListaPacientes"
                        class="form-select">
                    <option value="0">
                        -- Seleccione un paciente --
                    </option>
                </select>

                <span asp-validation-for="PacienteId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Motivo"
                       class="form-label">
                    Motivo de la solicitud
                </label>

                <textarea asp-for="Motivo"
                          class="form-control"
                          rows="3"
                          placeholder="Explique por qué el paciente necesita atención especializada"></textarea>

                <span asp-validation-for="Motivo"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EspecialidadSolicitada"
                       class="form-label">
                    Especialidad solicitada
                </label>

                <input asp-for="EspecialidadSolicitada"
                       class="form-control"
                       placeholder="Ejemplo: Cardiología" />

                <span asp-validation-for="EspecialidadSolicitada"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EnfermeroAcompanante"
                       class="form-label">
                    Enfermero acompañante
                </label>

                <input asp-for="EnfermeroAcompanante"
                       class="form-control"
                       placeholder="Nombre del enfermero" />

                <span asp-validation-for="EnfermeroAcompanante"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Guardar solicitud
            </button>

            <a asp-controller="SolicitudMedica"
               asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
