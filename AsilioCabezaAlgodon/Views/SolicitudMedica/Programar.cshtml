
@model AsilioCabezaAlgodon.Entidades.CitaMedica

@{
    ViewData["Title"] = "Programar cita médica";

    var solicitud = ViewBag.Solicitud
        as AsilioCabezaAlgodon.Entidades.SolicitudMedica;
}

<div class="container mt-4">

    <h2>Programar cita médica</h2>

    <p>
        Asigne el médico especialista y el horario
        para atender la solicitud.
    </p>

    <hr />

    @if (solicitud != null)
    {
        <div class="alert alert-info">
            <strong>Solicitud No.:</strong> @solicitud.Id
            <br />
            <strong>Motivo:</strong> @solicitud.Motivo
            <br />
            <strong>Especialidad solicitada:</strong>
            @solicitud.EspecialidadSolicitada
            <br />
            <strong>Enfermero acompañante:</strong>
            @solicitud.EnfermeroAcompanante
        </div>
    }

    <div class="row">
        <div class="col-md-7">

            <form asp-controller="SolicitudMedica"
                  asp-action="Programar"
                  asp-route-id="@solicitud?.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="MedicoId"
                           class="form-label">
                        Médico especialista
                    </label>

                    <select asp-for="MedicoId"
                            asp-items="ViewBag.ListaMedicos"
                            class="form-select">
                        <option value="0">
                            -- Seleccione un médico --
                        </option>
                    </select>

                    <span asp-validation-for="MedicoId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Fecha"
                           class="form-label">
                        Fecha y hora de la cita
                    </label>

                    <input asp-for="Fecha"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="Fecha"
                          class="text-danger"></span>
                </div>

                <hr />

                <h4>Información económica</h4>

                <div class="mb-3">
                    <label asp-for="CostoConsulta"
                           class="form-label">
                        Costo de consulta (Q)
                    </label>

                    <input asp-for="CostoConsulta"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="CostoConsulta"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descuento"
                           class="form-label">
                        Descuento de la fundación (Q)
                    </label>

                    <input asp-for="Descuento"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="Descuento"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-secondary">
                    El estado del pago quedará pendiente.
                    Los abonos podrán registrarse desde
                    el módulo de pagos.
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Programar cita
                </button>

                <a asp-controller="SolicitudMedica"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
