
@model AsilioCabezaAlgodon.Entidades.ExamenLaboratorio

@{
    ViewData["Title"] = "Registrar Examen de Laboratorio";
}

<h2>Registrar Examen de Laboratorio</h2>

<p>Ingrese los datos del examen realizado al paciente.</p>

<form asp-controller="ExamenLaboratorio"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Visita médica</label>

        <select asp-for="VisitaMedicaId"
                asp-items="ViewBag.ListaVisitas"
                class="form-select">
            <option value="">Seleccione una visita médica</option>
        </select>

        <span asp-validation-for="VisitaMedicaId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Nombre del examen</label>

        <input asp-for="NombreExamen"
               class="form-control"
               placeholder="Ejemplo: Hemograma completo"
               required />

        <span asp-validation-for="NombreExamen"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Resultado</label>

        <textarea asp-for="Resultado"
                  class="form-control"
                  rows="4"
                  required></textarea>

        <span asp-validation-for="Resultado"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Costo" class="form-label">
            Costo del examen (Q)
        </label>

        <input asp-for="Costo"
               type="number"
               step="0.01"
               min="0"
               class="form-control"
               required />

        <span asp-validation-for="Costo"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha del examen</label>

        <input asp-for="Fecha"
               type="datetime-local"
               asp-format="{0:yyyy-MM-ddTHH:mm}"
               class="form-control"
               required />

        <span asp-validation-for="Fecha"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar examen
    </button>

    <a asp-controller="ExamenLaboratorio"
       asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
