
@model AsilioCabezaAlgodon.Entidades.ExamenLaboratorio

@{
    ViewData["Title"] = "Solicitar Examen de Laboratorio";
}

<h2>Solicitar Examen de Laboratorio</h2>

<p>
    El médico solicita el examen y el laboratorio
    registra los resultados posteriormente.
</p>

<form asp-controller="ExamenLaboratorio"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="VisitaMedicaId"
               class="form-label">
            Visita médica
        </label>

        <select asp-for="VisitaMedicaId"
                asp-items="ViewBag.ListaVisitas"
                class="form-select">
            <option value="0">
                Seleccione una visita médica
            </option>
        </select>

        <span asp-validation-for="VisitaMedicaId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NombreExamen"
               class="form-label">
            Nombre del examen
        </label>

        <input asp-for="NombreExamen"
               class="form-control"
               placeholder="Ejemplo: Hemograma completo"
               maxlength="200"
               required />

        <span asp-validation-for="NombreExamen"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Costo"
               class="form-label">
            Costo del examen (Q)
        </label>

        <input asp-for="Costo"
               type="number"
               step="0.01"
               min="0"
               class="form-control"
               required />

        <span asp-validation-for="Costo"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descuento"
               class="form-label">
            Descuento de la fundación (Q)
        </label>

        <input asp-for="Descuento"
               type="number"
               step="0.01"
               min="0"
               class="form-control"
               required />

        <span asp-validation-for="Descuento"
              class="text-danger"></span>

        <small class="text-muted">
            Si no hay descuento, ingrese 0.
        </small>
    </div>

    <div class="mb-3">
        <label asp-for="Fecha"
               class="form-label">
            Fecha de solicitud
        </label>

        <input asp-for="Fecha"
               type="datetime-local"
               asp-format="{0:yyyy-MM-ddTHH:mm}"
               class="form-control"
               required />

        <span asp-validation-for="Fecha"
              class="text-danger"></span>
    </div>

    <div class="alert alert-info">
        El resultado quedará pendiente hasta que
        el laboratorio lo registre.
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar solicitud de examen
    </button>

    <a asp-controller="ExamenLaboratorio"
       asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
