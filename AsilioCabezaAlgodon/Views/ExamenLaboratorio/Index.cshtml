
@model List<AsilioCabezaAlgodon.Entidades.ExamenLaboratorio>

@{
    ViewData["Title"] = "Exámenes de Laboratorio";

    var visitas = ViewBag.Visitas as List<AsilioCabezaAlgodon.Entidades.VisitaMedica>;
    var citas = ViewBag.Citas as List<AsilioCabezaAlgodon.Entidades.CitaMedica>;
    var pacientes = ViewBag.Pacientes as List<AsilioCabezaAlgodon.Entidades.Paciente>;
}

<h2>Exámenes de Laboratorio</h2>

<p>
    Consulte los exámenes solicitados y sus resultados.
</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">
        @TempData["Aviso"]
    </div>
}

@if (User.IsInRole("Administrador") ||
     User.IsInRole("Medico"))
{
    <a asp-controller="ExamenLaboratorio"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Solicitar examen
    </a>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Paciente</th>
                <th>Examen</th>
                <th>Estado</th>
                <th>Resultado</th>
                <th>Fecha</th>
                <th>Costo (Q)</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var examen in Model)
            {
                var visita = visitas?.FirstOrDefault(
                    v => v.Id == examen.VisitaMedicaId);

                var cita = citas?.FirstOrDefault(
                    c => c.Id == visita?.CitaMedicaId);

                var paciente = pacientes?.FirstOrDefault(
                    p => p.Id == cita?.PacienteId);

                bool pendiente =
                    string.IsNullOrWhiteSpace(examen.Resultado);

                <tr>
                    <td>
                        @(paciente == null
                            ? "No disponible"
                            : paciente.Nombre + " " +
                              paciente.Apellido)
                    </td>

                    <td>@examen.NombreExamen</td>

                    <td>
                        @if (pendiente)
                        {
                            <span class="badge bg-warning text-dark">
                                Pendiente
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Realizado
                            </span>
                        }
                    </td>

                    <td>
                        @if (pendiente)
                        {
                            <span class="text-muted">
                                Sin resultados
                            </span>
                        }
                        else
                        {
                            @examen.Resultado
                        }
                    </td>

                    <td>
                        @examen.Fecha.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        Q @examen.Costo.ToString("N2")
                    </td>

                    <td>
                        @if (pendiente &&
                             (User.IsInRole("Administrador") ||
                              User.IsInRole("Laboratorio")))
                        {
                            <a asp-controller="ExamenLaboratorio"
                               asp-action="Resultado"
                               asp-route-id="@examen.Id"
                               class="btn btn-success btn-sm">
                                Registrar resultado
                            </a>
                        }
                        else if (!pendiente)
                        {
                            <span class="text-success">
                                Completado
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Pendiente
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Todavía no hay exámenes registrados.
    </div>
}

<a asp-controller="Home"
   asp-action="Index"
   class="btn btn-secondary">
    Volver al inicio
</a>
