
@model AsilioCabezaAlgodon.Entidades.Pago

@{
    ViewData["Title"] = "Registrar Pago";
}

<div class="container mt-4">

    <h2>Registrar Pago</h2>
    <p>Ingrese los datos del pago realizado para el paciente.</p>

    <form asp-controller="Pago"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="PacienteId" class="form-label">
                Paciente
            </label>

            <select asp-for="PacienteId"
                    asp-items="ViewBag.ListaPacientes"
                    class="form-select">
                <option value="0">Seleccione un paciente</option>
            </select>

            <span asp-validation-for="PacienteId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Monto" class="form-label">
                Monto (Q)
            </label>

            <input asp-for="Monto"
                   type="number"
                   step="0.01"
                   min="0.01"
                   class="form-control"
                   required />

            <span asp-validation-for="Monto"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Fecha" class="form-label">
                Fecha del pago
            </label>

            <input asp-for="Fecha"
                   type="date"
                   class="form-control"
                   required />

            <span asp-validation-for="Fecha"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Concepto" class="form-label">
                Concepto del pago
            </label>

            <input asp-for="Concepto"
                   class="form-control"
                   placeholder="Ejemplo: Mensualidad de octubre"
                   required />

            <span asp-validation-for="Concepto"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar pago
        </button>

        <a asp-controller="Pago"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
