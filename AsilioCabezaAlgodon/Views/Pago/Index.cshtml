
@model List<AsilioCabezaAlgodon.Entidades.Pago>

@{
    ViewData["Title"] = "Pagos Registrados";

    var nombresPacientes =
        ViewBag.NombresPacientes as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="container mt-4">

    <h2>Pagos Registrados</h2>
    <p>Listado de pagos realizados para los pacientes del asilo.</p>

    @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
    {
        <a asp-controller="Pago"
           asp-action="Create"
           class="btn btn-primary mb-3">
            Registrar Pago
        </a>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Nombre del Paciente</th>
                <th>Concepto</th>
                <th>Fecha</th>
                <th>Monto (Q)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var pago in Model)
            {
                <tr>
                    <td>
                        @if (nombresPacientes.TryGetValue(
                            pago.PacienteId, out var nombrePaciente))
                        {
                            @nombrePaciente
                        }
                        else
                        {
                            <span>Paciente no encontrado</span>
                        }
                    </td>

                    <td>@pago.Concepto</td>

                    <td>@pago.Fecha.ToString("dd/MM/yyyy")</td>

                    <td>Q @pago.Monto.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no hay pagos registrados.
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Volver al inicio
    </a>

</div>
