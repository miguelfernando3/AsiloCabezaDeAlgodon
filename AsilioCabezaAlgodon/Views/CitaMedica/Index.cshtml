
@model List<AsilioCabezaAlgodon.Entidades.CitaMedica>

@{
    ViewData["Title"] = "Citas Médicas";

    var pacientes = (List<AsilioCabezaAlgodon.Entidades.Paciente>)
        ViewBag.Pacientes;

    var medicos = (List<AsilioCabezaAlgodon.Entidades.Medico>)
        ViewBag.Medicos;
}

<div class="container mt-4">

    <h2>Citas Médicas</h2>

    <p>Listado de citas médicas del asilo.</p>

    @if (User.IsInRole("Administrador") ||
         User.IsInRole("Recepcionista") ||
         User.IsInRole("Fundacion"))
    {
        <a asp-controller="CitaMedica"
           asp-action="Create"
           class="btn btn-primary mb-3">
            Registrar Cita Médica
        </a>
    }

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Paciente</th>
                <th>Médico</th>
                <th>Especialidad</th>
                <th>Fecha</th>
                <th>Motivo</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var cita in Model)
            {
                var paciente = pacientes.FirstOrDefault(
                    p => p.Id == cita.PacienteId);

                var medico = medicos.FirstOrDefault(
                    m => m.Id == cita.MedicoId);

                <tr>
                    <td>
                        @(paciente != null
                            ? paciente.Nombre + " " + paciente.Apellido
                            : "No encontrado")
                    </td>

                    <td>
                        @(medico != null
                            ? medico.Nombre + " " + medico.Apellido
                            : "No asignado")
                    </td>

                    <td>
                        @(medico != null
                            ? medico.Especialidad
                            : "Sin especialidad")
                    </td>

                    <td>
                        @cita.Fecha.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>@cita.Motivo</td>

                    <td>
                        @if (cita.Estado == "Programada")
                        {
                            <span class="badge bg-primary">
                                Programada
                            </span>
                        }
                        else if (cita.Estado == "Atendida")
                        {
                            <span class="badge bg-success">
                                Atendida
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @cita.Estado
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>

    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no hay citas médicas registradas.
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Volver al inicio
    </a>

</div>
