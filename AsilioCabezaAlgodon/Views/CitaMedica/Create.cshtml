
@model AsilioCabezaAlgodon.Entidades.CitaMedica

@{
    ViewData["Title"] = "Registrar Cita Médica";
}

<div class="container mt-4">

    <h2>Registrar Cita Médica</h2>

    <p>Complete la información para programar una cita.</p>

    <form asp-controller="CitaMedica"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <!-- PACIENTE -->
        <div class="mb-3">
            <label asp-for="PacienteId" class="form-label">
                Paciente
            </label>

            <select asp-for="PacienteId"
                    asp-items="ViewBag.ListaPacientes"
                    class="form-select">
                <option value="">Seleccione un paciente</option>
            </select>

            <span asp-validation-for="PacienteId"
                  class="text-danger"></span>
        </div>

        <!-- MEDICO -->
        <div class="mb-3">
            <label asp-for="MedicoId" class="form-label">
                Médico
            </label>

            <select asp-for="MedicoId"
                    asp-items="ViewBag.ListaMedicos"
                    class="form-select">
                <option value="">Seleccione un médico</option>
            </select>

            <span asp-validation-for="MedicoId"
                  class="text-danger"></span>
        </div>

        <!-- FECHA -->
        <div class="mb-3">
            <label asp-for="Fecha" class="form-label">
                Fecha y hora
            </label>

            <input asp-for="Fecha"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="Fecha"
                  class="text-danger"></span>
        </div>

        <!-- MOTIVO -->
        <div class="mb-3">
            <label asp-for="Motivo" class="form-label">
                Motivo de la cita
            </label>

            <textarea asp-for="Motivo"
                      class="form-control"
                      rows="3"></textarea>

            <span asp-validation-for="Motivo"
                  class="text-danger"></span>
        </div>

        <hr />

        <h4>Información económica de la consulta</h4>

        <p class="text-muted">
            Registre el costo de la consulta, el descuento
            otorgado por la fundación y el monto abonado.
        </p>

        <!-- COSTO -->
        <div class="mb-3">
            <label asp-for="CostoConsulta" class="form-label">
                Costo de consulta (Q)
            </label>

            <input asp-for="CostoConsulta"
                   type="number"
                   min="0"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="CostoConsulta"
                  class="text-danger"></span>
        </div>

        <!-- DESCUENTO -->
        <div class="mb-3">
            <label asp-for="Descuento" class="form-label">
                Descuento de la fundación (Q)
            </label>

            <input asp-for="Descuento"
                   type="number"
                   min="0"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="Descuento"
                  class="text-danger"></span>
        </div>

        <!-- MONTO PAGADO -->
        <div class="mb-3">
            <label asp-for="MontoPagado" class="form-label">
                Monto pagado (Q)
            </label>

            <input asp-for="MontoPagado"
                   type="number"
                   min="0"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="MontoPagado"
                  class="text-danger"></span>
        </div>

        <div class="alert alert-info">
            El estado del pago se calculará automáticamente
            al guardar la cita.
        </div>

        <!-- BOTONES -->
        <button type="submit" class="btn btn-primary">
            Guardar cita
        </button>

        <a asp-controller="CitaMedica"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
